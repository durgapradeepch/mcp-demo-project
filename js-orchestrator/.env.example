# Environment Configuration for JavaScript LangGraph Orchestrator
# Copy this file to .env and update the values for your environment

# Server Configuration
HOST=0.0.0.0
PORT=8000
NODE_ENV=development
DEBUG=true

# OpenAI/LLM Configuration
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30000
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1000

# MCP Server Configuration
MCP_SERVER_URL=http://localhost:3001
MCP_TIMEOUT=30000
MCP_MAX_RETRIES=3
MCP_RETRY_DELAY=1000
MCP_MAX_CONNECTIONS=10
MCP_HEALTH_CHECK_INTERVAL=30000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_SKIP_SUCCESS=false
RATE_LIMIT_SKIP_FAILED=false

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_CREDENTIALS=true

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_CONSOLE=true
LOG_FILE=false
LOG_DIRECTORY=logs
LOG_MAX_FILE_SIZE=20m
LOG_MAX_FILES=5

# Security Configuration
SECURITY_HELMET=true
SECURITY_CSP=true
TRUSTED_PROXIES=
SESSION_SECRET=change-this-in-production

# Workflow Configuration
WORKFLOW_MAX_PARALLEL_QUERIES=3
WORKFLOW_QUERY_TIMEOUT=120000
WORKFLOW_MAX_INVESTIGATION_DEPTH=3
WORKFLOW_ENABLE_ENHANCED=true
WORKFLOW_ENABLE_METRICS=true

# Performance Configuration
MAX_REQUEST_SIZE=10mb
KEEP_ALIVE_TIMEOUT=5000
HEADERS_TIMEOUT=60000
ENABLE_COMPRESSION=true
COMPRESSION_LEVEL=6