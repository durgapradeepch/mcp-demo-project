# Neo4j Configuration
NEO4J_AUTH=neo4j/your_password_here
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_HOST=127.0.0.1
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_DATABASE=neo4j

# Neo4j Memory Settings
NEO4J_HEAP_INITIAL_SIZE=512m
NEO4J_HEAP_MAX_SIZE=2G
NEO4J_PAGECACHE_SIZE=512m

# MCP Server Configuration
SERVER_PORT=3001

# OpenAI API Key (Keep this secret!)
OPENAI_API_KEY=sk-your-openai-api-key-here

# VictoriaLogs Configuration
VICTORIA_METRICS_URL=https://vlinsert.dev.manifestit.tech/select/vmui
VICTORIA_LOGS_API_URL=https://vlinsert.dev.manifestit.tech/select/logsql